[Unit]
Description=OpenVPN WebUI
After=network.target

[Service]
Type=simple
User=vpn-admin
Group=vpn-admin
ExecStart=/data/ovpn/ovpn-cli --config /data/ovpn/config.json
WorkingDirectory=/data/ovpn/data
Restart=on-failure
RestartSec=5
TimeoutStopSec=190
# 先让 Web 等待关键操作完成；超时也不能杀死写到一半的 EasyRSA 子进程。
KillMode=process
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# 受限 helper 通过 sudo 提权，因此这里不能开启 NoNewPrivileges。
# /etc/openvpn 仅对 helper 可写，Web 用户仍受 Unix 文件权限限制。
ReadWritePaths=/etc/openvpn /data/ovpn/data /run/vpn-admin-helper
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
